# =============================================================
#  Git ignore — PotenFYR Multi-Language Eggs
#  Runtime data, build artifacts, dependencies, secrets, editor junk
# =============================================================

# --- Dependencies -------------------------------------------
node_modules/
vendor/
bower_components/
jspm_packages/
.pnp/
.pnp.js

# --- Python ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
pip-log.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- JavaScript / TypeScript ---------------------------------
.next/
.nuxt/
.output/
.svelte-kit/
.turbo/
.parcel-cache/
coverage/
*.tsbuildinfo
.eslintcache

# --- Rust / C / C++ / Go / Zig / others ----------------------
target/
Cargo.lock.orig
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
server
cobapp
app
zig-cache/
.zig-cache/
zig-out/
pkg/

# --- Java / .NET ---------------------------------------------
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
.gradle/
bin/[Rr]elease/
obj/
[Bb]in/
[Oo]bj/
project.lock.json
artifacts/
publish/

# --- Ruby / PHP / Elixir / Dart ------------------------------
.bundle/
Gemfile.lock.bak
vendor/bundle/
composer.phar
.phpunit.result.cache
_deps/
_build/
*.beam
.dart_tool/
.packages
.flutter-plugins*

# --- Runtime / launcher state (generated inside containers) ---
.environments/
.runtimes/
.logs/
.local/
.cache/
bin/
.potenfyr/
.multi-prog.conf
.env.local
.env.*.local
!.env.example

# --- Secrets & credentials (never commit) --------------------
.env
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
secrets*.json
credentials*.json

# --- Editor / OS junk ----------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.vs/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
*.log

# --- Local test/scratch artifacts -----------------------------
scratch/
tmp/
*.tar.gz
