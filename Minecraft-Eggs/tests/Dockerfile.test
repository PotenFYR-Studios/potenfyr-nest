# Fast mirror of the production image layout for launcher behavior tests.
# Same paths, same non-root uid (988), same signal contract - without the
# multi-minute build of the full multi-JVM image. The fake server is a
# python3 HTTP process launched via SERVER_TYPE=custom, exercising the exact
# same stdin plumbing as the real java servers.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    USER=container \
    HOME=/home/container

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget jq procps python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 988 container 2>/dev/null || true \
    && useradd -d /home/container -m -u 988 -g 988 container 2>/dev/null || true \
    && mkdir -p /home/container /usr/local/bin /mnt/server /tmp \
    && chmod -R 777 /home/container /usr/local/bin /mnt/server /tmp

# Egg runtime scripts live root-owned in /opt/potenfyr (same isolation as the
# production image); /usr/local/bin + /entrypoint.sh are compatibility
# symlinks. Users (uid 988) can read+execute but never modify them.
COPY install.sh entrypoint.sh run.sh install-java.sh /opt/potenfyr/
COPY tests/t5b-driver.py /opt/potenfyr/t5b-driver.py
COPY tests/fake-server.py /home/container/fake-server.py

RUN sed -i 's/\r$//' /opt/potenfyr/*.sh /opt/potenfyr/*.py /home/container/fake-server.py \
    && chown root:root /opt/potenfyr/* \
    && chmod 755 /opt/potenfyr \
    && chmod 755 /opt/potenfyr/*.sh \
    && chmod 644 /opt/potenfyr/t5b-driver.py \
    && ln -sf /opt/potenfyr/entrypoint.sh /entrypoint.sh \
    && ln -sf /opt/potenfyr/entrypoint.sh /usr/local/bin/entrypoint.sh \
    && ln -sf /opt/potenfyr/run.sh /run.sh \
    && ln -sf /opt/potenfyr/run.sh /usr/local/bin/run.sh \
    && ln -sf /opt/potenfyr/install.sh /install.sh \
    && ln -sf /opt/potenfyr/install.sh /usr/local/bin/install.sh \
    && ln -sf /opt/potenfyr/install-java.sh /usr/local/bin/install-java.sh \
    && echo "PotenFYR Multi Minecraft Runtime • variant=test • built=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > /etc/potenfyr-version

USER container
ENV USER=container HOME=/home/container
WORKDIR /home/container

STOPSIGNAL SIGTERM
CMD ["/bin/bash", "/entrypoint.sh"]
